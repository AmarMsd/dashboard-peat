# Salin file ini menjadi .env lalu isi nilainya.
# Variabel VITE_* dibaca saat build, jadi jalankan ulang `npm run dev` / build ulang setelah mengubahnya.

# URL webhook Chat Trigger n8n ("When chat message received" -> Chat URL)
VITE_N8N_CHAT_URL=https://n8n.contoh.id/webhook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx/chat

# (Opsional) Alamat backend FastAPI. Default: http://127.0.0.1:8000/api
VITE_API_BASE=http://127.0.0.1:8000/api

# Salin file ini menjadi .env lalu isi nilainya.

# URL Production Chat Trigger n8n ("When chat message received" -> Chat URL, berisi /webhook/).
# Dibaca oleh SERVER dashboard (route /api/chat), jadi tidak terlihat oleh pengunjung dan
# tidak perlu pengaturan CORS di n8n. Cukup restart server setelah diubah (tanpa build ulang).
N8N_CHAT_URL=https://n8n.contoh.id/webhook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx/chat

# (Opsional, tidak disarankan) Panggil n8n langsung dari browser. Butuh Allowed Origins (CORS)
# di n8n dan membuat URL n8n terlihat publik. Dibaca saat build. Kosongkan untuk memakai /api/chat.
# VITE_N8N_CHAT_URL=

# (Opsional) Alamat backend FastAPI. Default: http://127.0.0.1:8000/api
VITE_API_BASE=http://127.0.0.1:8000/api
